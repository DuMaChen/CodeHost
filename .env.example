NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
GITEA_BASE_URL=http://localhost:3001
GITEA_PUBLIC_URL=http://localhost:3001
GITEA_WEBHOOK_SECRET=replace-with-a-32-byte-secret
SESSION_ENCRYPTION_KEY=replace-with-a-32-byte-key
PLATFORM_PUBLIC_URL=http://localhost:3000
K8S_MODE=local
KUBECONFIG=./infra/k3d/kubeconfig
MAX_ACTIVE_RUNS=1
MAX_QUEUED_RUNS=3
AGENT_PROVIDER=mock
PREVIEW_MODE=local
REGISTRY_PUSH_HOST=ai-registry:5000
REGISTRY_PULL_HOST=ai-registry:5000
