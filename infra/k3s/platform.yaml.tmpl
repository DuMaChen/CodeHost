apiVersion: v1
kind: Service
metadata:
  name: platform-web
  namespace: platform-system
  labels:
    app.kubernetes.io/name: platform-web
spec:
  selector:
    app.kubernetes.io/name: platform-web
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: platform-web
  namespace: platform-system
  labels:
    app.kubernetes.io/name: platform-web
    app.kubernetes.io/part-of: ai-native-pr-platform
    platform.io/start-phase: runtime
spec:
  replicas: 1
  revisionHistoryLimit: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: platform-web
  template:
    metadata:
      labels:
        app.kubernetes.io/name: platform-web
        app.kubernetes.io/part-of: ai-native-pr-platform
    spec:
      serviceAccountName: platform-app
      automountServiceAccountToken: false
      nodeSelector:
        kubernetes.io/os: linux
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: api-ready-gate
          image: ${PLATFORM_API_IMAGE}
          imagePullPolicy: IfNotPresent
          command: ["node", "--input-type=module", "-e"]
          args:
            - |
              const deadline = Date.now() + 300000;
              while (Date.now() < deadline) {
                try {
                  const response = await fetch("http://platform-api:3000/readyz");
                  if (response.ok) process.exit(0);
                } catch {}
                await new Promise((resolve) => setTimeout(resolve, 2000));
              }
              console.error("platform API did not become ready before the deadline");
              process.exit(1);
          securityContext:
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 128Mi
      containers:
        - name: web
          image: ${PLATFORM_WEB_IMAGE}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 101
            runAsGroup: 101
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          ports:
            - name: http
              containerPort: 80
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 256Mi
          readinessProbe:
            httpGet:
              path: /
              port: http
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          volumeMounts:
            - name: nginx-config
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
              readOnly: true
            - name: tmp
              mountPath: /var/cache/nginx
            - name: run
              mountPath: /var/run
      volumes:
        - name: nginx-config
          configMap:
            name: platform-web-nginx
        - name: tmp
          emptyDir:
            sizeLimit: 32Mi
        - name: run
          emptyDir:
            sizeLimit: 16Mi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: platform-worker
  namespace: platform-system
  labels:
    app.kubernetes.io/name: platform-worker
    app.kubernetes.io/part-of: ai-native-pr-platform
    platform.io/start-phase: runtime
spec:
  replicas: 1
  revisionHistoryLimit: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: platform-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: platform-worker
        app.kubernetes.io/part-of: ai-native-pr-platform
    spec:
      serviceAccountName: platform-worker
      automountServiceAccountToken: true
      nodeSelector:
        kubernetes.io/os: linux
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
        fsGroup: 1000
      initContainers:
        - name: api-ready-gate
          image: ${PLATFORM_API_IMAGE}
          imagePullPolicy: IfNotPresent
          command: ["node", "--input-type=module", "-e"]
          args:
            - |
              const deadline = Date.now() + 300000;
              while (Date.now() < deadline) {
                try {
                  const response = await fetch("http://platform-api:3000/readyz");
                  if (response.ok) process.exit(0);
                } catch {}
                await new Promise((resolve) => setTimeout(resolve, 2000));
              }
              console.error("platform API did not become ready before the deadline");
              process.exit(1);
          securityContext:
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 128Mi
      containers:
        - name: worker
          image: ${PLATFORM_WORKER_IMAGE}
          imagePullPolicy: IfNotPresent
          command: ["node", "apps/worker/dist/main.js"]
          securityContext:
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          env:
            - name: NODE_ENV
              value: production
            - name: PORT
              value: "3001"
            - name: WORKER_HEALTH_PORT
              value: "3001"
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: platform-runtime
                  key: database-url
            - name: GITEA_WEBHOOK_SECRET
              valueFrom:
                secretKeyRef:
                  name: platform-runtime
                  key: gitea-webhook-secret
            - name: SESSION_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: platform-runtime
                  key: session-encryption-key
            - name: GITEA_RUNNER_TOKEN
              valueFrom:
                secretKeyRef:
                  name: platform-runtime
                  key: gitea-runner-token
            - name: GITEA_PLATFORM_TOKEN
              valueFrom:
                secretKeyRef:
                  name: platform-runtime
                  key: gitea-platform-token
          envFrom:
            - configMapRef:
                name: platform-config
          ports:
            - name: health
              containerPort: 3001
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 20
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          volumeMounts:
            - name: logs
              mountPath: /var/log/platform
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: logs
          persistentVolumeClaim:
            claimName: platform-logs
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
