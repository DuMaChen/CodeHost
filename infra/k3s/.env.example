# Server-only values. REGISTRY_HOST is a private DNS name or private IP,
# without scheme, path, or port. It must not resolve to localhost.
REGISTRY_HOST=registry.internal.example
REGISTRY_API_URL=http://registry.internal.example:30500
PLATFORM_HOST=platform.internal.example
GITEA_HOST=gitea.internal.example
PLATFORM_PUBLIC_URL=https://platform.internal.example
PREVIEW_MODE=ingress
PREVIEW_BASE_URL=http://preview.internal.example
PREVIEW_TLS_SECRET_NAME=preview-tls
# SSH mode only. The API returns a tunnel command when PREVIEW_MODE=ssh.
# PREVIEW_SSH_HOST=registrar.internal.example
# PREVIEW_SSH_USER=registrar
# PREVIEW_SSH_PORT=22
PLATFORM_API_IMAGE=registry.internal.example:30500/platform-api:0.1.0
PLATFORM_WORKER_IMAGE=registry.internal.example:30500/platform-worker:0.1.0
PLATFORM_AGENT_IMAGE=registry.internal.example:30500/platform-agent:0.1.0
PLATFORM_WEB_IMAGE=registry.internal.example:30500/platform-web:0.1.0
PLATFORM_RUNNER_IMAGE=registry.internal.example:30500/platform-runner@sha256:replace-with-64-lowercase-hex-digits
PLATFORM_PREVIEW_IMAGE=registry.internal.example:30500/platform-preview@sha256:replace-with-64-lowercase-hex-digits
PLATFORM_TLS_SECRET_NAME=platform-tls
AGENT_REPLICAS=1
POSTGRES_PASSWORD=replace-before-apply
DATABASE_URL=postgres://platform:replace-before-apply@postgres:5432/platform
GITEA_WEBHOOK_SECRET=replace-with-a-32-byte-secret
SESSION_ENCRYPTION_KEY=replace-with-a-32-byte-session-key
GITEA_RUNNER_TOKEN=replace-with-a-short-lived-gitea-token
GITEA_PLATFORM_TOKEN=replace-with-a-gitea-token-for-status-and-comment
GITEA_OAUTH_CLIENT_ID=replace-with-gitea-oauth-client-id
GITEA_OAUTH_CLIENT_SECRET=replace-with-gitea-oauth-client-secret
AGENT_PROVIDER=mock
