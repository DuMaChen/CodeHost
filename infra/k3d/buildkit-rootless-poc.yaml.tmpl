apiVersion: v1
kind: Namespace
metadata:
  name: buildkit-poc
  labels:
    platform.io/managed: "true"
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: buildkit-context
  namespace: buildkit-poc
data:
  Dockerfile: |
    FROM busybox:1.36.1
    USER 65532
    LABEL run_id="buildkit-poc"
---
apiVersion: batch/v1
kind: Job
metadata:
  name: buildkit-rootless-poc
  namespace: buildkit-poc
  labels:
    platform.io/managed: "true"
    platform.io/step-key: buildkit-poc
spec:
  completions: 1
  parallelism: 1
  backoffLimit: 0
  activeDeadlineSeconds: 900
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        platform.io/managed: "true"
        platform.io/step-key: buildkit-poc
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: buildkit
          image: ${BUILDKIT_IMAGE}
          imagePullPolicy: IfNotPresent
          command: ["buildctl-daemonless.sh"]
          args:
            - build
            - --frontend
            - dockerfile.v0
            - --local
            - context=/work/context
            - --local
            - dockerfile=/work/context
            - --output
            - type=image,name=${BUILD_IMAGE}:run-buildkit-poc,push=true,registry.insecure=true
          env:
            - name: BUILDKITD_FLAGS
              value: --oci-worker-snapshotter=native
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
              ephemeral-storage: 256Mi
            limits:
              cpu: 1
              memory: 1Gi
              ephemeral-storage: 1Gi
          volumeMounts:
            - name: context
              mountPath: /work/context
              readOnly: true
            - name: buildkit-state
              mountPath: /home/user/.local/share/buildkit
            - name: rootless-tmp
              mountPath: /home/user/.local/tmp
            - name: runtime
              mountPath: /run/user/1000
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: context
          configMap:
            name: buildkit-context
        - name: buildkit-state
          emptyDir:
            sizeLimit: 1Gi
        - name: rootless-tmp
          emptyDir:
            sizeLimit: 16Mi
        - name: runtime
          emptyDir:
            sizeLimit: 16Mi
        - name: tmp
          emptyDir:
            sizeLimit: 128Mi
