# Compose-only values. Do not reuse the k3d or k3s registry host here.
COMPOSE_REGISTRY_HOST=registry:5000
REGISTRY_API_URL=http://registry:5000
COMPOSE_NETWORK_NAME=ai-platform-compose
COMPOSE_POSTGRES_VOLUME=ai-platform-compose-postgres
COMPOSE_GITEA_VOLUME=ai-platform-compose-gitea
COMPOSE_REGISTRY_VOLUME=ai-platform-compose-registry
COMPOSE_LOG_VOLUME=ai-platform-compose-logs
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-with-a-local-password
GITEA_BASE_URL=http://gitea:3000
GITEA_RUNNER_BASE_URL=http://host.k3d.internal:3001
GITEA_WEBHOOK_SECRET=replace-with-a-32-byte-secret
SESSION_ENCRYPTION_KEY=replace-with-a-32-byte-session-key
GITEA_OAUTH_CLIENT_ID=replace-with-gitea-oauth-client-id
GITEA_OAUTH_CLIENT_SECRET=replace-with-gitea-oauth-client-secret
PLATFORM_PUBLIC_URL=http://localhost:3000
AGENT_PROVIDER=mock
WORKFLOW_EXECUTOR=fixture
K8S_STORAGE_CLASS=local-path
# Set WORKFLOW_EXECUTOR=kubernetes only after k3d and the digest-pinned images are ready.
K8S_RUNNER_IMAGE=registry.example.test/platform/runner@sha256:replace
K8S_PREVIEW_IMAGE=registry.example.test/platform/preview@sha256:replace
GITEA_RUNNER_TOKEN=replace-with-a-short-lived-runner-token
GITEA_PLATFORM_TOKEN=replace-with-a-gitea-token-for-status-and-comment
AGENT_REVIEW_URL=http://agent-review:3002
API_PORT=3000
GITEA_PORT=3001
GITEA_SSH_PORT=2222
REGISTRY_DEBUG_PORT=5001
WEB_PORT=8080
KUBECONFIG=./infra/k3d/kubeconfig
KUBECONFIG_WORKER=./infra/k3d/kubeconfig.worker
